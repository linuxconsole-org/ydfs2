ARCHIVE=$HOME/ydfs/tarballs/"$DIR".run
pkgver=`basename $DIR| cut -d'-' -f4`
pkgdir=/$HOME/ydfs/packages-x86_64/nvidia-$pkgver/$HOME/$ARCH
[ -e "$pkgdir" ] && echo "$pkgdir exists, skip building" && exit 0
cd $HOME/ydfs/src
mkdir nvidia
cd nvidia 
[ ! -e "$DIR" ] && sh $ARCHIVE --extract-only

 cd $DIR

	echo "srcdir : $srcdir"
	echo "pkgdir : $pkgdir"
    # bash
    tar xjvf nvidia-persistenced-init.tar.bz2

    # X driver

    install -Dm755 nvidia_drv.so "${pkgdir}/lib/xorg/modules/drivers/nvidia_drv.so"

    # Wayland/GBM
    mkdir -p "${pkgdir}/lib/gbm"
    ln -sr "${pkgdir}/lib/libnvidia-allocator.so.${pkgver}" "${pkgdir}/lib/gbm/nvidia-drm_gbm.so"

    # firmware
    install -Dm644 -t "${pkgdir}/lib/firmware/nvidia/${pkgver}/" firmware/*.bin

    # GLX extension module for X
    install -Dm755 "libglxserver_nvidia.so.${pkgver}" "${pkgdir}/lib/nvidia/xorg/libglxserver_nvidia.so.${pkgver}"
    # Ensure that X finds glx
    ln -s "libglxserver_nvidia.so.${pkgver}" "${pkgdir}/lib/nvidia/xorg/libglxserver_nvidia.so.1"
    ln -s "libglxserver_nvidia.so.${pkgver}" "${pkgdir}/lib/nvidia/xorg/libglxserver_nvidia.so"

    install -Dm755 "libGLX_nvidia.so.${pkgver}" "${pkgdir}/lib/libGLX_nvidia.so.${pkgver}"

    # OpenGL libraries
    install -Dm755 "libEGL_nvidia.so.${pkgver}" "${pkgdir}/lib/libEGL_nvidia.so.${pkgver}"
    install -Dm755 "libGLESv1_CM_nvidia.so.${pkgver}" "${pkgdir}/lib/libGLESv1_CM_nvidia.so.${pkgver}"
    install -Dm755 "libGLESv2_nvidia.so.${pkgver}" "${pkgdir}/lib/libGLESv2_nvidia.so.${pkgver}"
    install -Dm644 "10_nvidia.json" "${pkgdir}/share/glvnd/egl_vendor.d/10_nvidia.json"

    # OpenGL core library
    install -Dm755 "libnvidia-glcore.so.${pkgver}" "${pkgdir}/lib/libnvidia-glcore.so.${pkgver}"
    install -Dm755 "libnvidia-eglcore.so.${pkgver}" "${pkgdir}/lib/libnvidia-eglcore.so.${pkgver}"
    install -Dm755 "libnvidia-glsi.so.${pkgver}" "${pkgdir}/lib/libnvidia-glsi.so.${pkgver}"

    # misc
    install -Dm755 "libnvidia-api.so.1" "${pkgdir}/lib/libnvidia-api.so.1"
    install -Dm755 "libnvidia-fbc.so.${pkgver}" "${pkgdir}/lib/libnvidia-fbc.so.${pkgver}"
    install -Dm755 "libnvidia-encode.so.${pkgver}" "${pkgdir}/lib/libnvidia-encode.so.${pkgver}"
    install -Dm755 "libnvidia-cfg.so.${pkgver}" "${pkgdir}/lib/libnvidia-cfg.so.${pkgver}"
    install -Dm755 "libnvidia-ml.so.${pkgver}" "${pkgdir}/lib/libnvidia-ml.so.${pkgver}"
    install -Dm755 "libnvidia-fmdrv.so.${pkgver}" "${pkgdir}/lib/libnvidia-fmdrv.so.${pkgver}"
    install -Dm755 "libnvidia-imex.so.${pkgver}" "${pkgdir}/lib/libnvidia-imex.so.${pkgver}"
    install -Dm755 "libnvidia-glvkspirv.so.${pkgver}" "${pkgdir}/lib/libnvidia-glvkspirv.so.${pkgver}"
    install -Dm755 "libnvidia-allocator.so.${pkgver}" "${pkgdir}/lib/libnvidia-allocator.so.${pkgver}"
    install -Dm755 "libnvidia-gpucomp.so.${pkgver}" "${pkgdir}/lib/libnvidia-gpucomp.so.${pkgver}"

    # Vulkan ICD
    install -Dm644 "nvidia_icd.json" "${pkgdir}/share/vulkan/icd.d/nvidia_icd.json"
    install -Dm644 "nvidia_layers.json" "${pkgdir}/share/vulkan/implicit_layer.d/nvidia_layers.json"

    # VulkanSC
    install -D -m755 nvidia-pcc -t "${pkgdir}/bin"
    install -D -m755 "libnvidia-vksc-core.so.${pkgver}" -t "${pkgdir}/lib"
    install -D -m644 nvidia_icd_vksc.json -t "${pkgdir}/share/vulkansc/icd.d"

    # VDPAU
    install -Dm755 "libvdpau_nvidia.so.${pkgver}" "${pkgdir}/lib/vdpau/libvdpau_nvidia.so.${pkgver}"

    # nvidia-tls library
    install -Dm755 "libnvidia-tls.so.${pkgver}" "${pkgdir}/lib/libnvidia-tls.so.${pkgver}"

    # CUDA
    install -Dm755 "libcuda.so.${pkgver}" "${pkgdir}/lib/libcuda.so.${pkgver}"
    install -Dm755 "libnvcuvid.so.${pkgver}" "${pkgdir}/lib/libnvcuvid.so.${pkgver}"
    install -Dm755 "libcudadebugger.so.${pkgver}" "${pkgdir}/lib/libcudadebugger.so.${pkgver}"

    # NVVM Compiler library loaded by the CUDA driver to do JIT link-time-optimization
    install -Dm644 "libnvidia-nvvm.so.${pkgver}" "${pkgdir}/lib/libnvidia-nvvm.so.${pkgver}"
    install -Dm755 "libnvidia-nvvm70.so.4" "${pkgdir}/lib/libnvidia-nvvm70.so.4"

    # PTX JIT Compiler (Parallel Thread Execution (PTX) is a pseudo-assembly language for CUDA)
    install -Dm755 "libnvidia-ptxjitcompiler.so.${pkgver}" "${pkgdir}/lib/libnvidia-ptxjitcompiler.so.${pkgver}"

    # raytracing
    install -Dm755 "nvoptix.bin" "${pkgdir}/share/nvidia/nvoptix.bin"
    install -Dm755 "libnvoptix.so.${pkgver}" "${pkgdir}/lib/libnvoptix.so.${pkgver}"
    install -Dm755 "libnvidia-rtcore.so.${pkgver}" "${pkgdir}/lib/libnvidia-rtcore.so.${pkgver}"

    # NGX
    install -Dm755 nvidia-ngx-updater "${pkgdir}/bin/nvidia-ngx-updater"
    install -Dm755 "libnvidia-ngx.so.${pkgver}" "${pkgdir}/lib/libnvidia-ngx.so.${pkgver}"
    install -Dm755 libnvidia-ngx-builtin-dlssd.so.* -t "${pkgdir}/lib"
    if [[ $CARCH = x86_64 ]]; then
      install -Dm755 _nvngx.dll "${pkgdir}/lib/nvidia/wine/_nvngx.dll"
      install -Dm755 nvngx.dll "${pkgdir}/lib/nvidia/wine/nvngx.dll"
      install -Dm755 nvngx_dlssg.dll "${pkgdir}/lib/nvidia/wine/nvngx_dlssg.dll"
      install -Dm755 nvngx_update.exe "${pkgdir}/lib/nvidia/wine/nvngx_update.exe"
      # nvidia-installer flattens this to wine/, while _nvngx.dll refers to ngx-builtins
      install -Dm755 ngx-builtins/nvngx_dlssd.dll "${pkgdir}/lib/nvidia/wine/nvngx_dlssd.dll"
      install -d "${pkgdir}/lib/nvidia/wine/ngx-builtins"
      ln -s ../nvngx_dlssd.dll "${pkgdir}/lib/nvidia/wine/ngx-builtins/nvngx_dlssd.dll"
    fi

    # Optical flow
    install -Dm755 "libnvidia-opticalflow.so.${pkgver}" "${pkgdir}/lib/libnvidia-opticalflow.so.${pkgver}"

    if [[ $CARCH = x86_64 ]]; then
      # Cryptography library wrapper
      install -Dm755 "libnvidia-pkcs11.so.${pkgver}" "${pkgdir}/lib/libnvidia-pkcs11.so.${pkgver}"
      install -Dm755 "libnvidia-pkcs11-openssl3.so.${pkgver}" "${pkgdir}/lib/libnvidia-pkcs11-openssl3.so.${pkgver}"
    fi

    # Sandboxhelper
    install -Dm755 "libnvidia-sandboxutils.so.${pkgver}" "${pkgdir}/lib/libnvidia-sandboxutils.so.${pkgver}"

    # Present Helper
    install -Dm755 "libnvidia-present.so.${pkgver}" "${pkgdir}/lib/libnvidia-present.so.${pkgver}"

    # https://github.com/microsoft/TileIR
    install -Dm755 "libnvidia-tileiras.so.${pkgver}" "${pkgdir}/lib/libnvidia-tileiras.so.${pkgver}"

    # Debug
    install -Dm755 nvidia-debugdump "${pkgdir}/bin/nvidia-debugdump"

    # nvidia-xconfig
    install -Dm755 nvidia-xconfig "${pkgdir}/bin/nvidia-xconfig"
    install -Dm644 nvidia-xconfig.1.gz "${pkgdir}/share/man/man1/nvidia-xconfig.1.gz"

    # nvidia-bug-report
    install -Dm755 nvidia-bug-report.sh "${pkgdir}/bin/nvidia-bug-report.sh"

    # nvidia-smi
    install -Dm755 nvidia-smi "${pkgdir}/bin/nvidia-smi"
    install -Dm644 nvidia-smi.1.gz "${pkgdir}/share/man/man1/nvidia-smi.1.gz"

    # nvidia-cuda-mps
    install -Dm755 nvidia-cuda-mps-server "${pkgdir}/bin/nvidia-cuda-mps-server"
    install -Dm755 nvidia-cuda-mps-control "${pkgdir}/bin/nvidia-cuda-mps-control"
    install -Dm644 nvidia-cuda-mps-control.1.gz "${pkgdir}/share/man/man1/nvidia-cuda-mps-control.1.gz"

    # nvidia-modprobe
    # This should be removed if nvidia fixed their uvm module!
    install -Dm4755 nvidia-modprobe "${pkgdir}/bin/nvidia-modprobe"
    install -Dm644 nvidia-modprobe.1.gz "${pkgdir}/share/man/man1/nvidia-modprobe.1.gz"

    # nvidia-persistenced
    install -Dm755 nvidia-persistenced "${pkgdir}/bin/nvidia-persistenced"
    install -Dm644 nvidia-persistenced.1.gz "${pkgdir}/share/man/man1/nvidia-persistenced.1.gz"
    install -Dm644 nvidia-persistenced-init/systemd/nvidia-persistenced.service.template "${pkgdir}/lib/systemd/system/nvidia-persistenced.service"
    sed -i 's/__USER__/nvidia-persistenced/' "${pkgdir}/lib/systemd/system/nvidia-persistenced.service"

    # application profiles
    install -Dm644 "nvidia-application-profiles-${pkgver}-rc" "${pkgdir}/share/nvidia/nvidia-application-profiles-${pkgver}-rc"
    install -Dm644 "nvidia-application-profiles-${pkgver}-key-documentation" "${pkgdir}/share/nvidia/nvidia-application-profiles-${pkgver}-key-documentation"

    install -Dm644 LICENSE "${pkgdir}/share/licenses/nvidia-utils/LICENSE"
    install -Dm644 README.txt "${pkgdir}/share/doc/nvidia/README"
    install -Dm644 NVIDIA_Changelog "${pkgdir}/share/doc/nvidia/NVIDIA_Changelog"
    cp -r html "${pkgdir}/share/doc/nvidia/"
    ln -s nvidia "${pkgdir}/share/doc/nvidia-utils"

    # new power management support
    install -Dm644 systemd/system/*.service -t "${pkgdir}/lib/systemd/system"
    install -Dm755 systemd/system-sleep/nvidia "${pkgdir}/lib/systemd/system-sleep/nvidia"
    install -Dm755 systemd/nvidia-sleep.sh "${pkgdir}/bin/nvidia-sleep.sh"
    install -Dm755 nvidia-powerd "${pkgdir}/bin/nvidia-powerd"
    install -Dm644 dlsnetparams.csv "${pkgdir}/share/nvidia/nvidia-powerd/dlsnetparams.csv"
    install -Dm644 nvidia-dbus.conf "${pkgdir}/share/dbus-1/system.d/nvidia-dbus.conf"
    install -Dm644 "${srcdir}/systemd-homed-override.conf" "${pkgdir}/lib/systemd/system/systemd-homed.service.d/10-nvidia-no-freeze-session.conf"
    install -Dm644 "${srcdir}/systemd-suspend-override.conf" "${pkgdir}/lib/systemd/system/systemd-suspend.service.d/10-nvidia-no-freeze-session.conf"
    install -Dm644 "${srcdir}/systemd-suspend-override.conf" "${pkgdir}/lib/systemd/system/systemd-suspend-then-hibernate.service.d/10-nvidia-no-freeze-session.conf"
    install -Dm644 "${srcdir}/systemd-suspend-override.conf" "${pkgdir}/lib/systemd/system/systemd-hibernate.service.d/10-nvidia-no-freeze-session.conf"
    install -Dm644 "${srcdir}/systemd-suspend-override.conf" "${pkgdir}/lib/systemd/system/systemd-hybrid-sleep.service.d/10-nvidia-no-freeze-session.conf"

    # distro specific files must be installed in /share/X11/xorg.conf.d
    install -Dm644 "${srcdir}/nvidia-drm-outputclass.conf" "${pkgdir}/share/X11/xorg.conf.d/10-nvidia-drm-outputclass.conf"

    install -Dm644 "${srcdir}/nvidia-utils.sysusers" "${pkgdir}/lib/sysusers.d/$pkgname.conf"

    install -Dm644 "${srcdir}/nvidia.rules" "$pkgdir"/lib/udev/rules.d/60-nvidia.rules

    # Enable kernel suspend notifiers for open modules and override TemporaryFilePath
    # from default /tmp to /var/tmp
    install -Dm644 "${srcdir}/nvidia-utils.conf" "${pkgdir}/lib/modprobe.d/nvidia-utils.conf"

    # Lists NVIDIA driver files for container runtimes like nvidia-container-toolkit
    install -Dm644 sandboxutils-filelist.json "${pkgdir}/share/nvidia/files.d/sandboxutils-filelist.json"

    # create soname links
    find "$pkgdir" -type f -name '*.so*' ! -path '*xorg/*' -print0 | while read -d $'\0' _lib; do
        _soname=$(dirname "${_lib}")/$(readelf -d "${_lib}" | grep -Po 'SONAME.*: \[\K[^]]*' || true)
        _base=$(echo ${_soname} | sed -r 's/(.*)\.so.*/\1.so/')
        [[ -e "${_soname}" ]] || ln -s $(basename "${_lib}") "${_soname}"
        [[ -e "${_base}" ]] || ln -s $(basename "${_soname}") "${_base}"
    done

cd $HOME/ydfs/packages-x86_64/nvidia-$pkgver
$HOME_DIBAB/scripts/make_opkg

echo
