#!/bin/bash
PKG=$1
SHORT=${PKG:0:2}
install -d $HOME/archpkg
cd $HOME/archpkg
URL1=https://gitlab.archlinux.org/archlinux/packaging/packages/$1/-/raw/main/PKGBUILD?ref_type=heads
URL2=https://aur.archlinux.org/cgit/aur.git/plain/PKGBUILD?h=$PKG
OPTION=" -s" 

if [ ! -e $HOME/archpkg/$PKG ]
then
curl $OPTION "$URL1" -o $HOME/archpkg/$PKG 
grep 'gitlab.archlinux.org/users/sign_in' $HOME/archpkg/$PKG >/dev/null && curl $OPTION "$URL2" -o $HOME/archpkg/$PKG 
[ ! -e $HOME/archpkg/$PKG ] && exit 1
fi

test -s $HOME/archpkg/$PKG
if [ $? = 1 ]
then
 echo "Error, delete $HOME/archpkg/$PKG which is empty"
 rm $HOME/archpkg/$PKG
 exit 1
fi

source $HOME/archpkg/$PKG

for i in ${!source[*]}
do 
 echo ${source[i]}
 break
done
