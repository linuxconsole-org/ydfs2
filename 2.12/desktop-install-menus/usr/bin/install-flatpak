#!/bin/bash
set -e

FREEMEG=$(free -m |grep Mem |  gawk '{print $4}')
if [ "$FREEMEG" -gt "4000" ]
then
  echo "Free mem : $FREEMEG, OK"
else
  echo "$FREEMEG Mb is not enough free memory, please visit https://github.com/linuxconsole-org/ydfs2/blob/2.12/TIPS.md"
  read key
  exit 1
fi

flatpak remotes
if [ "$USER" == "root" ]
then
  flatpak remote-add --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo
  flatpak install -y io.github.flattool.Warehouse || zenity --warning --text="Cannot Install Warehouse !"
else
  flatpak remote-add --user --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo
  flatpak install --user -y io.github.flattool.Warehouse || zenity --warning --text="Cannot Install Warehouse !"
fi

dbus-launch flatpak run io.github.flattool.Warehouse || sleep 10

sleep 5

