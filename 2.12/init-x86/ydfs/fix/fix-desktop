if [ ! -e $HOME/.config/autostart ]
then
install -d $HOME/.config/autostart
for app in nm-applet.desktop mate-power-manager.desktop # blueman.desktop
do
  cp /usr/etc/xdg/autostart/$app $HOME/.config/autostart/$app
  #echo "Hidden=true" >> $HOME/.config/autostart/$app
done
fi

if [ ! -e /ydfs/boot/options/nounderscan ]
then
  OUTPUT=$(xrandr |grep primary |cut -d' ' -f1)
  echo Output is $OUTPUT
  xrandr --output $OUTPUT --set underscan auto 2>/dev/null
fi

[ ! -e $HOME/.local/share/icons/org.flameshot.Flameshot.png ] && install -d $HOME/.local/share/icons && cp /usr/share/icons/hicolor/48x48/apps/org.flameshot.Flameshot.png $HOME/.local/share/icons

ls /ydfs/modules/ |while read module
do
  [ ! -e /ydfs/modules/$module/share/applications ] && continue
  echo $XDG_DATA_DIRS | grep $HOME_DIBAB/$module/share >/dev/null || export XDG_DATA_DIRS=$XDG_DATA_DIRS:$HOME_DIBAB/$module/share
  echo "XDG_DATA_DIRS=$XDG_DATA_DIRS" > $HOME/.xdg-data-dir
done

xset s off
xset -dpms

# Fix file access on live USB mode

[ ! -e /media/ydfs/ydfs.cfg ] && flatpak override --user --filesystem=$HOME

[ -e $HOME/.xdg-data-dir ] && . $HOME/.xdg-data-dir

echo XDG_DATA_DIRS $XDG_DATA_DIRS
