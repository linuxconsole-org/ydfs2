while [ 1 ]
do
sleep 3
if [ -e /home/linuxconsole2026/x86_64/var/lib/flatpak/exports/ ]
then
ls /home/linuxconsole2026/x86_64/var/lib/flatpak/exports/share/applications/ | while read app
do
