# [ -e /media/ydfs/wireless.cfg ] && WIRELESSCFG=/media/ydfs/wireless.cfg 

# MultiOS USB
[ -e /disk/ydfs/wireless.cfg ] && WIRELESSCFG=/disk/ydfs/wireless.cfg 
# Rufus
[ -e /media/ydfs/ydfs/wireless.cfg ] && WIRELESSCFG=/media/ydfs/ydfs/wireless.cfg 

echo $WIRELESSCFG

if [ -n "$WIRELESSCFG" ] && [ -f "$WIRELESSCFG" ]
then
  echo "Using $WIRELESSCFG"
  while ! ping -c 2 www.free.fr
  do
    sleep 2.1
    nmcli dev wifi | grep Infra | gawk '{print $2}' | while read SSID
    do
      echo -n "$SSID : key exists ?"
      KEY=$(grep ":$SSID:" $WIRELESSCFG | cut -d':' -f3)
      [ "$KEY" = "" ] && echo " .. No " && continue
      echo " .. Yes"
      echo $SSID $KEY
      ls /sys/class/net/ | while read network
      do
        [ -e /sys/class/net/$network/wireless ] || continue
        echo Network $network  
        nmcli dev wifi connect $SSID password "$KEY"
      done
      break
    done
  [ -e /tmp/break-detect-wireless ] && break
  done
fi
