if [ -e /root/.ydfs/fixydfs ]
  then
     ls /root/.ydfs/fixydfs |while read file
     do
       echo /root/.ydfs/fixydfs/$file
       bash /root/.ydfs/fixydfs/$file
     done
fi

# Enable dmesg for users
echo 0 > /proc/sys/kernel/dmesg_restrict

# YDFS 2.12

chown root:root /home/linuxconsole2026/x86_64/libexec/sudo/sudoers.so
chown root:root /home/linuxconsole2026/x86_64/etc/sudo/sudoers
chown root:root /home/linuxconsole2026/x86_64/etc/sudo/sudoers.d
chmod +s /home/linuxconsole2026/x86_64/bin/sudo

grep NOPASSWD /etc/sudoers | echo '%sudo ALL=(ALL) NOPASSWD:ALL' >> /etc/sudoers

# Mount Ventoy as disk
[ -e /ventoy ] && [ -e /dev/dm-1 ] && install -d /disk && mount /dev/dm-1 /disk

echo
