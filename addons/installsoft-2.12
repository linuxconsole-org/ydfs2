SOFT=$1
. /etc/profile

if [ "$SOFT" == "thunderbird" ]
then
LANG=en-US

[ -e $HOME/.config/ydfs/lang ] && . $HOME/.config/ydfs/lang

[ "$lang" = "Russian" ] && LANG=ru
[ "$lang" = "Chinese" ] && LANG=zh-CN
[ "$lang" = "French" ] && LANG=fr
[ "$lang" = "Breton" ] && LANG=br
[ "$lang" = "Quebec" ] && LANG=br
[ "$lang" = "Italian" ] && LANG=it
[ "$lang" = "German" ] && LANG=de
[ "$lang" = "Spanish" ] && LANG=es-ES
[ "$lang" = "Portuguese" ] && LANG=pt-PT

cat /proc/cmdline | grep layoutcode=fr >/dev/null && LANG=fr

wget https://gitlab.archlinux.org/archlinux/packaging/packages/thunderbird/-/raw/main/PKGBUILD -O PKGBUILD
FIREFOX=$(grep pkgver= PKGBUILD  | cut -d'=' -f2)
rm PKGBUILD 

ARCH="x86_64"
if [ "$ARCH" = "x86" ]
then
  URL=http://ftp.mozilla.org/pub/thunderbird/releases/$FIREFOX/linux-i686/$LANG/thunderbird-"$FIREFOX".tar.xz
else
  URL=http://ftp.mozilla.org/pub/thunderbird/releases/$FIREFOX/linux-$ARCH/$LANG/thunderbird-"$FIREFOX".tar.xz
fi

cd $HOME

if [ ! -e $HOME/thunderbird ]
then
  DEST=$HOME /ydfs/start/download  $URL
  tar xJvf thunderbird-"$FIREFOX".tar.xz && rm thunderbird-"$FIREFOX".tar.xz
fi
$HOME/thunderbird/thunderbird
exit 0
fi

if [ "$SOFT" == "firefox" ]
then
LANG=en-US

[ -e $HOME/.config/ydfs/lang ] && . $HOME/.config/ydfs/lang

[ "$lang" = "Arabic" ] && LANG=ar
[ "$lang" = "Russian" ] && LANG=ru
[ "$lang" = "Chinese" ] && LANG=zh-CN
[ "$lang" = "French" ] && LANG=fr
[ "$lang" = "Breton" ] && LANG=br
[ "$lang" = "Quebec" ] && LANG=br
[ "$lang" = "Italian" ] && LANG=it
[ "$lang" = "German" ] && LANG=de
[ "$lang" = "Spanish" ] && LANG=es-ES
[ "$lang" = "Portuguese" ] && LANG=pt-PT

cat /proc/cmdline | grep layoutcode=fr >/dev/null && LANG=fr
wget https://gitlab.archlinux.org/archlinux/packaging/packages/firefox/-/raw/main/PKGBUILD
FIREFOX=$(grep pkgver= PKGBUILD  | cut -d'=' -f2)
rm PKGBUILD 

ARCH="x86_64"
if [ "$ARCH" = "x86" ]
then
  URL=http://ftp.mozilla.org/pub/firefox/releases/$FIREFOX/linux-i686/$LANG/firefox-"$FIREFOX".tar.xz
else
  URL=http://ftp.mozilla.org/pub/firefox/releases/$FIREFOX/linux-$ARCH/$LANG/firefox-"$FIREFOX".tar.xz
fi

cd $HOME

if [ ! -e $HOME/firefox ]
then
  DEST=$HOME /ydfs/start/download  $URL
  tar xJvf firefox-"$FIREFOX".tar.xz && rm firefox-"$FIREFOX".tar.xz
fi

$HOME/firefox/firefox 
exit 0
fi

if [ "$SOFT" == "google-chrome-stable" ]
then
  echo $HOME | grep home && zenity --error --text="Must be root to install Chrome  !" && exit 1
  if [ "$ARCH" = "x86" ]
  then
    URL=http://opkg.linuxconsole.org/linuxconsole/2.4/x86/google-chrome-stable.tar.gz
    DEST=$HOME /ydfs/start/download  $URL
    cd /
    tar xzvf $HOME/google-chrome-stable.tar.gz
    rm $HOME/google-chrome-stable.tar.gz
  else
    URL=https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb
    DEST=$HOME /ydfs/start/download  $URL
    dpkg -x $HOME/`basename $URL` /
    chmod 755 /
    rm $HOME/`basename $URL`
  fi
  google-chrome-stable --user-data-dir=/tmp --no-sandbox
  exit 0
fi

if [ "$SOFT" == "steam" ]
then
  if [ ! -e $HOME/.local/bin/steam ]
  then
  cd $HOME/.local/bin
  rm steam
  wget https://bitbucket.org/yourdistrofromscratch/ydfs/raw/master/2.8/init-x86/fix/steam
  chmod +x steam
  bash steam
  else
    $HOME/.local/bin/steam "$@"
  fi
fi

# debian wrapper
# apt-get install $1
# which $1 && $(which $1)
